<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ZenitQuickLook.appex — Finder thumbnails for projects (NL-PLAT-21).

  The sandbox and nothing else: no network, no user-selected files, no app group. Quick Look
  grants the extension read access to the one package it is asked about, for that request.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
